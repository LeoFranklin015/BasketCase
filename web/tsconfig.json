{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-fixture/types/**/*.ts",
    ".next-fixture/dev/types/**/*.ts",
    ".next-live/types/**/*.ts",
    ".next-live/dev/types/**/*.ts",
    ".next-live2/types/**/*.ts",
    ".next-live2/dev/types/**/*.ts",
    ".next-live3/types/**/*.ts",
    ".next-live3/dev/types/**/*.ts",
    ".next-live4/types/**/*.ts",
    ".next-live4/dev/types/**/*.ts",
    ".next-live5/types/**/*.ts",
    ".next-live5/dev/types/**/*.ts",
    ".next-live6/types/**/*.ts",
    ".next-live6/dev/types/**/*.ts",
    ".next-live7/types/**/*.ts",
    ".next-live7/dev/types/**/*.ts",
    ".next-live8/types/**/*.ts",
    ".next-live8/dev/types/**/*.ts",
    ".next-landing/types/**/*.ts",
    ".next-landing/dev/types/**/*.ts",
    ".next-live9/types/**/*.ts",
    ".next-live9/dev/types/**/*.ts",
    ".next-live10/types/**/*.ts",
    ".next-live10/dev/types/**/*.ts",
    ".next-design/types/**/*.ts",
    ".next-design/dev/types/**/*.ts",
    ".next-e2elive/types/**/*.ts",
    ".next-e2elive/dev/types/**/*.ts",
    ".next-mainnet/types/**/*.ts",
    ".next-mainnet/dev/types/**/*.ts",
    ".next-design-main/types/**/*.ts",
    ".next-design-main/dev/types/**/*.ts",
    ".next-designbuild/types/**/*.ts",
    ".next-designbuild/dev/types/**/*.ts",
    ".next-design-rpc/types/**/*.ts",
    ".next-design-rpc/dev/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-prod/dev/types/**/*.ts",
    ".next-mainnet-new/types/**/*.ts",
    ".next-mainnet-new/dev/types/**/*.ts",
    ".next-prod2/types/**/*.ts",
    ".next-prod2/dev/types/**/*.ts",
    ".next-prod3/types/**/*.ts",
    ".next-prod3/dev/types/**/*.ts",
    ".next-mainnet3/types/**/*.ts",
    ".next-mainnet3/dev/types/**/*.ts",
    ".next-prod4/types/**/*.ts",
    ".next-prod4/dev/types/**/*.ts",
    ".next-mainnet4/types/**/*.ts",
    ".next-mainnet4/dev/types/**/*.ts",
    ".next-redesign-dev/types/**/*.ts",
    ".next-redesign-dev/dev/types/**/*.ts",
    ".next-redesign/types/**/*.ts",
    ".next-redesign/dev/types/**/*.ts",
    ".next-xc/types/**/*.ts",
    ".next-xc/dev/types/**/*.ts",
    ".next-peek/types/**/*.ts",
    ".next-peek/dev/types/**/*.ts",
    ".next-redesign-fx/types/**/*.ts",
    ".next-redesign-fx/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
